# LocalFlow Backend 환경 변수 작성 예시
# 이 파일은 Git에 포함되는 공개 템플릿이며 Spring Boot가 로드하지 않습니다.
# 실제 사용 값은 .env에만 입력하고 API 키나 서비스 계정 파일은 커밋하지 마세요.

# HTTP 서버 포트입니다.
SERVER_PORT=8080
# H2 파일 데이터베이스 연결 주소입니다.
LOCALFLOW_DB_URL=jdbc:h2:file:./data/localflow;MODE=MySQL;AUTO_SERVER=TRUE
# 업로드된 프로젝트 사본을 보관할 디렉터리입니다.
LOCALFLOW_WORKSPACE_ROOT=./workspace

# AI에 전달할 프로젝트 맥락의 최대 문자 수입니다.
AI_CONTEXT_MAX_CHARS=60000
# AI 계획 한 건에서 허용할 최대 파일 작업 개수입니다.
AI_MAX_OPERATIONS=20

# OpenAI API 인증 키입니다. OpenAI를 사용하지 않으면 비워둡니다.
OPENAI_API_KEY=
# OpenAI 호환 API 기본 주소입니다.
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 작업 생성 모델입니다.
OPENAI_MODEL=gpt-5-mini
# UI에서 선택할 OpenAI 모델 목록입니다. 쉼표로 구분하며 OPENAI_MODEL 값이 기본 선택됩니다.
OPENAI_MODELS=gpt-5.1,gpt-5,gpt-5-mini,gpt-5-nano,gpt-4.1
# OpenAI 요청의 최대 출력 토큰 수입니다.
OPENAI_MAX_OUTPUT_TOKENS=6000

# OpenRouter에서 발급한 API 키입니다. 비어 있으면 Jev 대신 로컬 휴리스틱을 사용합니다.
OPENROUTER_API_KEY=
# OpenRouter의 Jev Decisions API 전체 주소입니다.
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# 작업 유형·대상·위험도 판단에 사용할 OpenRouter Jev 모델입니다.
JEV_MODEL=typesafe/jev-1.13

# 로컬 Ollama 사용 여부입니다. 설치와 모델 준비가 끝난 경우 true로 변경하세요.
OLLAMA_ENABLED=false
# 로컬 Ollama 서버 주소입니다. 별도 API 키는 필요하지 않습니다.
OLLAMA_BASE_URL=http://localhost:11434
# Ollama에서 미리 내려받은 생성 모델명입니다.
OLLAMA_MODEL=qwen2.5-coder:3b
# 제공자 상태 조회 결과를 재사용할 시간입니다.
OLLAMA_STATUS_CACHE_TTL=5s
# Ollama 연결 및 설치 모델 조회 제한 시간입니다.
OLLAMA_STATUS_TIMEOUT=2s
# 구조화된 JSON을 안정적으로 생성하기 위한 샘플링 온도입니다.
OLLAMA_TEMPERATURE=0
# 같은 입력의 결과를 재현하기 위한 난수 시드입니다.
OLLAMA_SEED=42
# 작업 계획에는 내부 추론 출력이 필요하지 않으므로 비활성화합니다.
OLLAMA_THINK=false
# 한 번의 Ollama 응답에서 생성할 최대 토큰 수입니다.
OLLAMA_NUM_PREDICT=4096
# 반복 요청 시 모델을 메모리에 유지할 시간입니다.
OLLAMA_KEEP_ALIVE=10m
# JSON Schema 파싱 실패 시 추가로 재시도할 횟수입니다. 최대 2회입니다.
OLLAMA_STRUCTURED_OUTPUT_RETRIES=1

# Vertex AI 서비스 계정 JSON 전체를 Base64로 인코딩한 한 줄 문자열입니다.
# JSON 원문이나 파일 경로가 아니라 [Convert]::ToBase64String(...) 결과를 입력하세요.
VERTEX_AI_SERVICE_ACCOUNT_BASE64=
# Vertex AI를 사용할 Google Cloud 프로젝트 ID입니다.
VERTEX_AI_PROJECT=
# Vertex AI 리전입니다.
VERTEX_AI_LOCATION=us-central1
# Vertex AI에서 호출할 Gemini 모델명입니다.
VERTEX_AI_MODEL=gemini-2.5-flash
# UI에서 선택할 Vertex AI 모델 목록입니다. 쉼표로 구분하며 VERTEX_AI_MODEL 값이 기본 선택됩니다.
VERTEX_AI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite
